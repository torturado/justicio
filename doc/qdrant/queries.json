// List collections
GET collections

// Inspect the main collection
GET collections/justicio

// Scroll consolidated legislation and return current metadata fields
POST collections/justicio/points/scroll
{
  "limit": 20,
  "with_payload": [
    "metadata.identificador",
    "metadata.fecha_publicacion",
    "metadata.source_type",
    "metadata.rango"
  ],
  "filter": {
    "must": [
      {
        "key": "metadata.source_type",
        "match": {
          "value": "Legislación consolidada"
        }
      }
    ]
  }
}

// Count points for a norm
POST collections/justicio/points/count
{
  "filter": {
    "must": [
      {
        "key": "metadata.identificador",
        "match": {
          "value": "BOE-A-2015-10565"
        }
      }
    ]
  }
}

// https://qdrant.tech/documentation/concepts/filtering/
// https://qdrant.tech/documentation/concepts/points/
