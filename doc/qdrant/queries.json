// List collections
GET collections

// Inspect the collection with the chunks of every source
GET collections/legal_documents

// Scroll consolidated legislation and return some metadata fields
POST collections/legal_documents/points/scroll
{
  "limit": 20,
  "with_payload": [
    "identificador",
    "bloque_titulo",
    "chunk_index",
    "fecha_vigencia_version",
    "rango"
  ],
  "filter": {
    "must": [
      { "key": "source_name", "match": { "value": "BOE" } },
      { "key": "source_type", "match": { "value": "Legislación consolidada" } }
    ]
  }
}

// Count the chunks of a document
POST collections/legal_documents/points/count
{
  "filter": {
    "must": [
      { "key": "source_name", "match": { "value": "BOE" } },
      { "key": "identificador", "match": { "value": "BOE-A-2015-10565" } }
    ]
  }
}

// Latest publication date indexed for a bulletin (the start of its next update)
POST collections/legal_documents/points/scroll
{
  "limit": 1,
  "with_payload": ["fecha_publicacion"],
  "order_by": { "key": "fecha_publicacion", "direction": "desc" },
  "filter": {
    "must": [
      { "key": "source_name", "match": { "value": "BOCM" } },
      { "key": "source_type", "match": { "value": "Boletin" } }
    ]
  }
}

// https://qdrant.tech/documentation/concepts/filtering/
// https://qdrant.tech/documentation/concepts/points/
