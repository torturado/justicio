#!/usr/bin/env bash

set -euo pipefail

env_args=()
hf_cache_dir="${HF_HOME:-$HOME/.cache/huggingface}"
mkdir -p "$hf_cache_dir"
for name in JUSTICIO_API_KEY GEMINI_API_KEY QDRANT_API_URL QDRANT_API_KEY TAVILY_API_KEY LANGTRACE_API_KEY; do
    if [[ -v "$name" ]]; then
        env_args+=(--env "$name")
    fi
done

docker run --rm -p 5000:5000 -v "$hf_cache_dir:/home/justicio/.cache/huggingface" "${env_args[@]}" justicio:latest
